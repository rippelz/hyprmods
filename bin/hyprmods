#!/usr/bin/env python3
"""hyprmods - install/enable manager for your Hyprland projects.

This is NOT a runtime mode switcher (Super+W still does that for winmode).
Toggling a project here wires or unwires it from Hyprland:

  ON  → binds, exec-once, sources, plugins active (installed)
  OFF → hotkeys do nothing, no boot hooks, daemons stopped (practically uninstalled)

Files:
  ~/.config/hyprmods/enabled.json     which projects are installed
  ~/.config/hypr/hyprmods.conf        generated snippet (sourced by hyprland)

Usage:
  hyprmods                 GTK manager
  hyprmods list
  hyprmods toggle winbar
  hyprmods on|off <id>
  hyprmods install <id>    clone from GitHub + run install.sh if missing
  hyprmods install-all     install every project that is not on disk
  hyprmods update <id>     pull latest from GitHub + reinstall
  hyprmods update-all      update every project that is behind GitHub
  hyprmods menu            rofi picker
  hyprmods apply           rewrite conf + reload (no state change)
  hyprmods migrate         strip legacy lines from hyprland.conf (once)
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Optional

HOME = Path.home()
BIN = HOME / ".local" / "bin"
LIB = HOME / ".local" / "lib"
STATE_ROOT = HOME / ".local" / "state"
CFG = HOME / ".config" / "hyprmods"
ENABLED_FILE = CFG / "enabled.json"
HYPR_DIR = HOME / ".config" / "hypr"
HYPR_CONF = HYPR_DIR / "hyprland.conf"
GENERATED = HYPR_DIR / "hyprmods.conf"
MARKER_BEGIN = "# >>> hyprmods managed (do not edit) >>>"
MARKER_END = "# <<< hyprmods managed <<<"
SOURCE_LINE = "source = ~/.config/hypr/hyprmods.conf"
THEME_CURRENT = HOME / ".config" / "themes" / ".current"
# Clones for projects not already present elsewhere on the system
SRC_ROOT = Path(
    os.environ.get("HYPRMODS_SRC", HOME / ".local" / "src" / "hyprmods")
)
GITHUB_OWNER = os.environ.get("HYPRMODS_GITHUB_OWNER", "rippelz")
# How long to cache GitHub update checks (seconds)
UPDATE_CACHE_TTL = float(os.environ.get("HYPRMODS_UPDATE_TTL", "300"))


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

def which(name: str) -> Optional[Path]:
    p = shutil.which(name)
    if p:
        return Path(p)
    cand = BIN / name
    return cand if cand.is_file() and os.access(cand, os.X_OK) else None


def run(
    argv: list[str] | str,
    *,
    timeout: float = 90,
    env: Optional[dict] = None,
) -> tuple[int, str]:
    if isinstance(argv, str):
        argv = [argv]
    e = {**os.environ, "PATH": f"{BIN}:{os.environ.get('PATH', '')}"}
    if env:
        e.update(env)
    try:
        r = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, env=e
        )
        out = (r.stdout or "") + (("\n" + r.stderr) if r.stderr else "")
        return r.returncode, out.strip()
    except FileNotFoundError:
        return 127, f"not found: {argv[0]}"
    except subprocess.TimeoutExpired:
        return 124, "timed out"


def notify(title: str, body: str = "") -> None:
    if which("notify-send"):
        subprocess.Popen(
            ["notify-send", "-a", "hyprmods", "-t", "2500", title, body],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def pgrep_x(name: str) -> bool:
    return run(["pgrep", "-x", name])[0] == 0


def pkill_x(name: str) -> None:
    run(["pkill", "-x", name])
    run(["pkill", "-9", "-x", name])


def plugin_loaded(needle: str) -> bool:
    code, out = run(["hyprctl", "plugin", "list"])
    return code == 0 and needle.lower() in out.lower()


def plugin_path(name: str) -> Optional[Path]:
    for p in (LIB / f"{name}.so", LIB / f"lib{name}.so"):
        if p.is_file():
            return p
    return None


def plugin_load(name: str) -> None:
    path = plugin_path(name)
    if not path or plugin_loaded(name):
        return
    run(["hyprctl", "plugin", "load", str(path)])


def plugin_unload(name: str) -> None:
    path = plugin_path(name)
    if not plugin_loaded(name):
        return
    if path:
        code, _ = run(["hyprctl", "plugin", "unload", str(path)])
        if code == 0:
            return
    run(["hyprctl", "plugin", "unload", name])


def current_theme() -> str:
    try:
        return THEME_CURRENT.read_text(encoding="utf-8").strip() or "-"
    except OSError:
        return "-"


def ensure_dirs() -> None:
    CFG.mkdir(parents=True, exist_ok=True)
    HYPR_DIR.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------------------------
# enable state
# ---------------------------------------------------------------------------

def default_enabled() -> dict[str, bool]:
    """First run: everything present on disk starts enabled."""
    return {m.id: True for m in PROJECTS}


def load_enabled() -> dict[str, bool]:
    ensure_dirs()
    base = default_enabled()
    if not ENABLED_FILE.is_file():
        save_enabled(base)
        return dict(base)
    try:
        data = json.loads(ENABLED_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return base
        # merge: known projects only; new projects default on
        out = dict(base)
        for k, v in data.items():
            if k in out:
                out[k] = bool(v)
        return out
    except (OSError, json.JSONDecodeError):
        return base


def save_enabled(state: dict[str, bool]) -> None:
    ensure_dirs()
    ENABLED_FILE.write_text(
        json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def is_enabled(pid: str, state: Optional[dict[str, bool]] = None) -> bool:
    st = state if state is not None else load_enabled()
    return bool(st.get(pid, True))


# ---------------------------------------------------------------------------
# project registry - install units
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class Keybind:
    """A key (or input) this project claims, and when it is active."""

    keys: str  # e.g. "Super+W"
    action: str  # short what it does
    when: str  # e.g. "always (while installed)", "winmode ON"


def kb(keys: str, action: str, when: str) -> Keybind:
    return Keybind(keys=keys, action=action, when=when)


@dataclass
class Project:
    id: str
    name: str
    desc: str
    category: str = "project"  # project | plugin | utility
    source: str = ""
    # GitHub repo for auto-install: "owner/name" or bare "name" (uses GITHUB_OWNER)
    github: str = ""
    # lines injected into hyprmods.conf when enabled (hyprland syntax)
    conf_lines: list[str] = field(default_factory=list)
    # keybinds this project eats (shown in UI/CLI)
    binds: list[Keybind] = field(default_factory=list)
    # optional: required binaries (any missing → show as not installed on disk)
    requires: list[str] = field(default_factory=list)
    # called when flipping OFF - stop daemons, clear mode, unload plugins
    on_disable: Optional[Callable[[], None]] = None
    # called when flipping ON - start boot helpers for this session
    on_enable: Optional[Callable[[], None]] = None
    # live activity (informational only - mode currently running)
    activity: Optional[Callable[[], str]] = None

    def on_disk(self) -> bool:
        if not self.requires:
            return True
        return all(which(r) is not None or plugin_path(r) is not None for r in self.requires)

    def repo_slug(self) -> str:
        g = (self.github or "").strip()
        if not g:
            return ""
        if "/" in g:
            return g
        return f"{GITHUB_OWNER}/{g}"

    def binds_by_when(self) -> list[tuple[str, list[Keybind]]]:
        """Group binds by circumstance, preserving first-seen order."""
        order: list[str] = []
        groups: dict[str, list[Keybind]] = {}
        for b in self.binds:
            if b.when not in groups:
                order.append(b.when)
                groups[b.when] = []
            groups[b.when].append(b)
        return [(w, groups[w]) for w in order]


def _empty_mode_conf() -> None:
    p = HYPR_DIR / "mode.conf"
    p.write_text(
        "# Managed by winmode - currently OFF (hyprmods disabled winbar).\n",
        encoding="utf-8",
    )


def _empty_infini_conf() -> None:
    p = HYPR_DIR / "infini.conf"
    p.write_text(
        "# Managed by infiniscroll - currently OFF (hyprmods disabled infiniscroll).\n",
        encoding="utf-8",
    )


def _disable_winbar() -> None:
    # Leave windows mode cleanly if active
    if (STATE_ROOT / "winmode" / "on").exists() and which("winmode"):
        run([str(which("winmode"))], timeout=30)
    # Force chrome out of winmode bits
    if which("winmode-chrome"):
        run([str(which("winmode-chrome")), "leave"], timeout=20)
    pkill_x("winbar-dock")
    pkill_x("winbar-desk")
    # Keep a normal waybar so the desktop isn't bar-less mid-session
    if not pgrep_x("waybar"):
        subprocess.Popen(
            ["waybar"],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    plugin_unload("hypr-minimize")
    _empty_mode_conf()
    # clear mode flag if leave didn't
    try:
        (STATE_ROOT / "winmode" / "on").unlink(missing_ok=True)
    except OSError:
        pass


def _enable_winbar() -> None:
    if which("winmode-boot"):
        subprocess.Popen(
            [str(which("winmode-boot"))],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif which("winmode-chrome"):
        run([str(which("winmode-chrome")), "boot"], timeout=20)


def _winbar_activity() -> str:
    if (STATE_ROOT / "winmode" / "on").exists():
        return "mode ON"
    if pgrep_x("waybar"):
        return "bar up"
    return ""


def _disable_infiniscroll() -> None:
    if (STATE_ROOT / "infiniscroll" / "on").exists() and which("infiniscroll"):
        run([str(which("infiniscroll"))], timeout=45)
    # belt-and-suspenders
    for name in ("infiniscroll-zoomd", "infiniscroll-under", "infiniscroll-pan", "infiniscroll-rt"):
        pkill_x(name)
    # pid files
    sd = STATE_ROOT / "infiniscroll"
    for pidf in ("zoomd.pid", "under.pid"):
        f = sd / pidf
        if f.is_file():
            try:
                pid = int(f.read_text().strip())
                os.kill(pid, 15)
            except (OSError, ValueError):
                pass
            try:
                f.unlink(missing_ok=True)
            except OSError:
                pass
    _empty_infini_conf()
    try:
        (STATE_ROOT / "infiniscroll" / "on").unlink(missing_ok=True)
    except OSError:
        pass


def _enable_infiniscroll() -> None:
    if which("infiniscroll-boot"):
        subprocess.Popen(
            [str(which("infiniscroll-boot"))],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def _infini_activity() -> str:
    if (STATE_ROOT / "infiniscroll" / "on").exists():
        return "mode ON"
    return ""


def _disable_theme() -> None:
    # Keep applied colors/wallpaper - only unwire Super+T.
    pass


def _enable_theme() -> None:
    pass


def _pgrep_f(pattern: str) -> bool:
    """True if a real process cmdline matches pattern (ignores pgrep/hyprmods noise)."""
    code, out = run(["pgrep", "-af", pattern])
    if code != 0 or not out:
        return False
    rx = re.compile(pattern)
    for line in out.splitlines():
        # "12345 /path/cmd args"
        cmd = line.split(None, 1)[1] if " " in line else line
        low = cmd.lower()
        if "pgrep" in low or "pkill" in low or "hyprmods" in low:
            continue
        if "dump_bash_state" in cmd or "GROK_AGENT" in cmd:
            continue
        if rx.search(cmd):
            return True
    return False


def _pkill_f(pattern: str) -> None:
    # Resolve PIDs with the same filter so we don't kill tooling shells.
    code, out = run(["pgrep", "-af", pattern])
    if code != 0 or not out:
        return
    rx = re.compile(pattern)
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) < 2:
            continue
        pid_s, cmd = parts[0], parts[1]
        low = cmd.lower()
        if "pgrep" in low or "pkill" in low or "hyprmods" in low:
            continue
        if "dump_bash_state" in cmd or "GROK_AGENT" in cmd:
            continue
        if not rx.search(cmd):
            continue
        try:
            os.kill(int(pid_s), 15)
        except (OSError, ValueError):
            pass
    time.sleep(0.1)
    # force leftovers
    code, out = run(["pgrep", "-af", pattern])
    if code != 0 or not out:
        return
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) < 2:
            continue
        pid_s, cmd = parts[0], parts[1]
        if "pgrep" in cmd.lower() or "hyprmods" in cmd.lower() or "dump_bash_state" in cmd:
            continue
        if not rx.search(cmd):
            continue
        try:
            os.kill(int(pid_s), 9)
        except (OSError, ValueError):
            pass


def _disable_wallpaper_boot() -> None:
    # Stop whatever wallpaper-boot would own this session.
    # (hyprmotion is third-party; wallpaper-boot may start it for video themes)
    if which("hyprmotion"):
        run([str(which("hyprmotion")), "stop"], timeout=15)
    pkill_x("mpvpaper")
    pkill_x("hyprmotion")
    pkill_x("hyprpaper")


def _enable_wallpaper_boot() -> None:
    if which("wallpaper-boot"):
        subprocess.Popen(
            [str(which("wallpaper-boot"))],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def _wallpaper_boot_activity() -> str:
    if pgrep_x("hyprmotion") or pgrep_x("mpvpaper"):
        return "video engine"
    if pgrep_x("hyprpaper"):
        return "static (hyprpaper)"
    return ""


def _disable_obs() -> None:
    # Stop replay buffer if OBS is up; leave the OBS window alone
    # (user may be mid-stream). Next login won't autostart.
    if which("obs-replay") and _pgrep_f(r"\bobs(\s|--)"):
        run([str(which("obs-replay")), "stop"], timeout=8)


def _enable_obs() -> None:
    if not which("obs-boot"):
        return
    if _pgrep_f(r"(^|/)obs(\s|$)|obs-studio"):
        return
    subprocess.Popen(
        [str(which("obs-boot"))],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _obs_activity() -> str:
    if _pgrep_f(r"(^|/)obs(\s|$)|obs-studio|--startreplaybuffer"):
        return "OBS up"
    return ""


def _disable_autoclicker() -> None:
    _pkill_f(r"autoclicker(\.py)?")


def _enable_autoclicker() -> None:
    # Interactive TUI - user launches with `autoclicker`. Nothing to boot.
    pass


def _autoclicker_activity() -> str:
    if _pgrep_f(r"autoclicker(\.py)?"):
        return "running"
    return ""


def _disable_app_recency() -> None:
    _pkill_f(r"app-recency")


def _enable_app_recency() -> None:
    if not which("app-recency"):
        return
    if _pgrep_f(r"app-recency"):
        return
    subprocess.Popen(
        [str(which("app-recency")), "daemon"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _app_recency_activity() -> str:
    if _pgrep_f(r"app-recency"):
        return "daemon"
    return ""


def _disable_nominsize() -> None:
    plugin_unload("hypr-nominsize")


def _enable_nominsize() -> None:
    plugin_load("hypr-nominsize")


def _disable_minimize() -> None:
    plugin_unload("hypr-minimize")


def _enable_minimize() -> None:
    plugin_load("hypr-minimize")


def _disable_rgb() -> None:
    if which("rgb"):
        run([str(which("rgb")), "off"], timeout=15)


def _enable_rgb() -> None:
    if which("rgb"):
        run([str(which("rgb")), "on"], timeout=15)


def _rgb_activity() -> str:
    f = HOME / ".cache" / "rgb_lights.state"
    try:
        if f.read_text().strip().lower() in ("on", "1", "true"):
            return "on"
    except OSError:
        pass
    return ""


def _hyprmods_activity() -> str:
    """Live label for the manager row (version comes from update check)."""
    return "manager"


