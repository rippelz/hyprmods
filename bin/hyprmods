            id="opaque",
            name="Solid window",
            desc="Glass ↔ solid for the focused window",
            category="utility",
            github="hypr-bits",
            requires=["toggle-opaque"],
            conf_lines=[
                "# solid window",
                "bind = $mainMod, O, exec, ~/.local/bin/toggle-opaque",
            ],
            binds=[
                kb("Super+O", "toggle solid / glass on focused window", "always (while installed)"),
            ],
        ),
        Project(
            id="hypr-nominsize",
            name="hypr-nominsize",
            desc="Plugin: ignore client min-size (Spotify etc.)",
            category="plugin",
            source=str(HOME / "code" / "hypr-nominsize"),
            github="hypr-nominsize",
            requires=["hypr-nominsize"],
            conf_lines=[
                "# hypr-nominsize",
                "exec-once = hyprctl plugin load $HOME/.local/lib/hypr-nominsize.so",
            ],
