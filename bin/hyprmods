# ---------------------------------------------------------------------------
# GitHub install + update checks
# ---------------------------------------------------------------------------

def _fmt_ver(v: str) -> str:
    """Pretty version for display (avoid vv0.1.0 when git describe already has v)."""
    v = (v or "").strip()
    if not v:
        return ""
    if v[0].isdigit():
        return f"v{v}"
    return v


@dataclass
class UpdateInfo:
    """Result of comparing a local clone to its GitHub remote tip."""

    slug: str
    status: str  # up_to_date | update_available | ahead | diverged | no_local | no_github | error
    local_sha: str = ""
    remote_sha: str = ""
    local_ver: str = ""
    remote_ver: str = ""
    detail: str = ""
    repo_dir: str = ""

    @property
    def available(self) -> bool:
        return self.status == "update_available"

    def short_label(self) -> str:
        lv = _fmt_ver(self.local_ver)
        rv = _fmt_ver(self.remote_ver)
        if self.status == "update_available":
            if lv and rv and self.local_ver != self.remote_ver:
                return f"↑ {lv} → {rv}"
            if rv:
                return f"↑ update · {rv}"
            if self.remote_sha:
                return f"↑ update · {self.remote_sha[:7]}"
            return "↑ update available"
        if self.status == "up_to_date":
            return f"up to date · {lv}" if lv else "up to date"
        if self.status == "ahead":
            return f"local ahead · {lv}" if lv else "local ahead of GitHub"
        if self.status == "diverged":
            ls = lv or (self.local_sha[:7] if self.local_sha else "?")
            rs = rv or (self.remote_sha[:7] if self.remote_sha else "?")
            return f"diverged · local {ls} / remote {rs}"
        if self.status == "error":
            return f"check fail · {self.detail[:48]}" if self.detail else "check fail"
        return ""


# slug → (monotonic_ts, UpdateInfo)
_update_cache: dict[str, tuple[float, UpdateInfo]] = {}
_update_lock = threading.Lock()


def _git_dir(path: Path) -> bool:
    """True if path is a git work tree (regular .git dir or worktree file)."""
    g = path / ".git"
    return g.is_dir() or g.is_file()


def find_repo_dir(p: Project) -> Optional[Path]:
    """Locate a local git checkout for this project (dev tree or SRC_ROOT clone)."""
    slug = p.repo_slug()
    name = slug.split("/")[-1] if slug else p.id
    candidates: list[Path] = []
    if p.source:
        src = Path(p.source).expanduser()
        if src.is_dir():
            candidates.append(src)
        elif src.parent.is_dir():
            candidates.append(src.parent)
    candidates.extend(
        [
            SRC_ROOT / name,
            HOME / "code" / name,
        ]
    )
    seen: set[Path] = set()
    for c in candidates:
        try:
            c = c.resolve()
        except OSError:
            continue
        if c in seen:
            continue
        seen.add(c)
        cur = c
        for _ in range(5):
            if _git_dir(cur):
                return cur
            if cur.parent == cur:
                break
            cur = cur.parent
    return None


def local_version(repo: Path) -> str:
    for name in ("VERSION", "version"):
        f = repo / name
        if f.is_file():
            try:
                line = f.read_text(encoding="utf-8").strip().splitlines()
                if line:
                    return line[0].strip()
            except OSError:
                pass
    code, out = run(
        ["git", "-C", str(repo), "describe", "--tags", "--always"], timeout=10
    )
    return out.strip() if code == 0 and out else ""


def local_sha(repo: Path) -> str:
    code, out = run(["git", "-C", str(repo), "rev-parse", "HEAD"], timeout=10)
    return out.strip() if code == 0 else ""


def remote_head_sha(slug: str) -> tuple[str, str]:
    """Return (full_sha, error). Prefer `gh` (private repos), else git ls-remote."""
    if which("gh"):
        code, out = run(
            ["gh", "api", f"repos/{slug}", "--jq", ".default_branch"],
            timeout=30,
        )
        branch = out.strip() if code == 0 and out.strip() else "main"
        code, out = run(
            ["gh", "api", f"repos/{slug}/commits/{branch}", "--jq", ".sha"],
            timeout=30,
        )
        if code == 0 and out.strip():
            return out.strip(), ""
        # fall through - token/rate issues etc.
    url = f"https://github.com/{slug}.git"
    code, out = run(["git", "ls-remote", url, "HEAD"], timeout=30)
    if code == 0 and out.strip():
        return out.strip().split()[0], ""
    return "", (out or f"could not reach github.com/{slug}")[:200]


def remote_version(slug: str) -> str:
    """Best-effort version string from GitHub (VERSION file, else latest tag)."""
    if not which("gh"):
        return ""
    code, out = run(
        ["gh", "api", f"repos/{slug}/contents/VERSION", "--jq", ".content"],
        timeout=30,
    )
    if code == 0 and out.strip():
        import base64

        try:
            # gh may return quoted JSON string content
            raw = out.strip().strip('"')
            text = base64.b64decode(raw).decode("utf-8").strip()
            if text:
                return text.splitlines()[0].strip()
        except Exception:
            pass
    code, out = run(
        ["gh", "api", f"repos/{slug}/tags", "--jq", ".[0].name"],
        timeout=30,
    )
    if code == 0 and out.strip():
        return out.strip().lstrip("v")
    return ""


def compare_local_to_remote(slug: str, local: str, remote: str) -> str:
    """Map GitHub compare status onto our labels.

    compare base...head with base=local, head=remote:
      identical → up_to_date
      ahead     → remote has new commits → update_available
      behind    → local has commits remote lacks → ahead
      diverged  → diverged
    """
    if local == remote:
        return "up_to_date"
    if which("gh"):
        code, out = run(
            [
                "gh",
                "api",
                f"repos/{slug}/compare/{local}...{remote}",
                "--jq",
                ".status",
            ],
            timeout=30,
        )
        st = out.strip() if code == 0 else ""
        if st == "identical":
            return "up_to_date"
        if st == "ahead":
            return "update_available"
        if st == "behind":
            return "ahead"
        if st == "diverged":
            return "diverged"
    # no gh / compare failed - treat any SHA mismatch as possible update
    return "update_available"


def invalidate_update_cache(slug: Optional[str] = None) -> None:
    with _update_lock:
        if slug is None:
            _update_cache.clear()
        else:
            _update_cache.pop(slug, None)


def check_update_for_slug(
    slug: str,
    repo: Optional[Path],
    *,
    force: bool = False,
) -> UpdateInfo:
    if not slug:
        return UpdateInfo(slug="", status="no_github")

    now = time.monotonic()
    with _update_lock:
        if not force and slug in _update_cache:
            ts, info = _update_cache[slug]
            if now - ts < UPDATE_CACHE_TTL:
                return info

    if not repo or not _git_dir(repo):
        info = UpdateInfo(slug=slug, status="no_local", detail="no local clone")
        with _update_lock:
            _update_cache[slug] = (now, info)
        return info

    lsha = local_sha(repo)
    lver = local_version(repo)
    if not lsha:
        info = UpdateInfo(
            slug=slug,
            status="error",
            detail="not a git checkout",
            local_ver=lver,
            repo_dir=str(repo),
        )
        with _update_lock:
            _update_cache[slug] = (now, info)
        return info

    rsha, err = remote_head_sha(slug)
    if not rsha:
        info = UpdateInfo(
            slug=slug,
            status="error",
            detail=err or "remote unreachable",
            local_sha=lsha,
            local_ver=lver,
            repo_dir=str(repo),
        )
        with _update_lock:
            _update_cache[slug] = (now, info)
        return info

    status = compare_local_to_remote(slug, lsha, rsha)
    rver = lver if status == "up_to_date" else (remote_version(slug) or "")
    info = UpdateInfo(
        slug=slug,
        status=status,
        local_sha=lsha,
        remote_sha=rsha,
        local_ver=lver,
        remote_ver=rver,
        repo_dir=str(repo),
    )
    with _update_lock:
        _update_cache[slug] = (now, info)
    return info


def check_update(p: Project, *, force: bool = False) -> UpdateInfo:
    slug = p.repo_slug()
    if not slug:
        return UpdateInfo(slug="", status="no_github")
    return check_update_for_slug(slug, find_repo_dir(p), force=force)


def check_all_updates(*, force: bool = False) -> dict[str, UpdateInfo]:
    """project id → UpdateInfo. One network check per unique GitHub slug."""
    by_slug: dict[str, list[Project]] = {}
    for p in PROJECTS:
        slug = p.repo_slug()
        if not slug:
            continue
        by_slug.setdefault(slug, []).append(p)

    slug_info: dict[str, UpdateInfo] = {}

    def _one(slug: str) -> tuple[str, UpdateInfo]:
        # prefer a project that has a resolvable local tree
        repo: Optional[Path] = None
        for p in by_slug[slug]:
            repo = find_repo_dir(p)
            if repo:
                break
        return slug, check_update_for_slug(slug, repo, force=force)

    with ThreadPoolExecutor(max_workers=min(6, max(1, len(by_slug)))) as pool:
        futs = [pool.submit(_one, s) for s in by_slug]
        for fut in as_completed(futs):
            slug, info = fut.result()
            slug_info[slug] = info

    out: dict[str, UpdateInfo] = {}
    for p in PROJECTS:
        slug = p.repo_slug()
        if not slug:
            out[p.id] = UpdateInfo(slug="", status="no_github")
        else:
            out[p.id] = slug_info.get(
                slug, UpdateInfo(slug=slug, status="unknown")
            )
    return out


def cached_update(p: Project) -> Optional[UpdateInfo]:
    """Return cached UpdateInfo if present and fresh; else None (no network)."""
    slug = p.repo_slug()
    if not slug:
        return UpdateInfo(slug="", status="no_github")
    now = time.monotonic()
    with _update_lock:
        hit = _update_cache.get(slug)
        if not hit:
            return None
        ts, info = hit
        if now - ts >= UPDATE_CACHE_TTL:
            return None
        return info


def clone_or_update(slug: str, dest: Optional[Path] = None) -> tuple[bool, Path, str]:
    """Clone github.com/slug into dest (default SRC_ROOT/<name>). Prefer `gh`."""
    name = slug.split("/")[-1]
    dest = dest or (SRC_ROOT / name)
    SRC_ROOT.mkdir(parents=True, exist_ok=True)

    if _git_dir(dest):
        code, out = run(["git", "-C", str(dest), "pull", "--ff-only"], timeout=120)
        if code != 0:
            # still usable if pull fails (offline etc.)
            return True, dest, f"pull warn: {out or 'failed'} (using existing clone)"
        return True, dest, f"updated {dest}"

    if dest.exists():
        shutil.rmtree(dest)

    # gh handles auth for private repos
    if which("gh"):
        code, out = run(
            ["gh", "repo", "clone", slug, str(dest)],
            timeout=300,
        )
        if code == 0 and _git_dir(dest):
            return True, dest, f"cloned {slug} → {dest}"

    url = f"https://github.com/{slug}.git"
    code, out = run(["git", "clone", url, str(dest)], timeout=300)
    if code != 0 or not _git_dir(dest):
        return False, dest, out or f"clone failed: {slug}"
    return True, dest, f"cloned {slug} → {dest}"


def run_install_script(repo_dir: Path) -> tuple[bool, str]:
    script = repo_dir / "install.sh"
    if not script.is_file():
        return False, f"no install.sh in {repo_dir}"
    code, out = run(["bash", str(script)], timeout=900)
    if code != 0:
        return False, out or f"install.sh exit {code}"
    return True, out or "install.sh ok"


def install_from_github(pid: str) -> tuple[bool, str]:
    """If binaries are missing, clone from GitHub and run install.sh."""
    p = get_project(pid)
    if not p:
        return False, f"unknown project: {pid}"
    if p.on_disk():
        return True, f"{p.name} already on disk"
    slug = p.repo_slug()
    if not slug:
        return False, (
            f"{p.name}: not on disk and no GitHub repo configured "
            f"(local-only project)"
        )

    ok, dest, msg = clone_or_update(slug)
    if not ok:
        return False, f"{p.name}: {msg}"

    ok2, msg2 = run_install_script(dest)
    if not ok2:
        return False, f"{p.name}: clone ok ({msg}); install failed: {msg2}"

    invalidate_update_cache(slug)
    if not p.on_disk():
        return False, (
            f"{p.name}: install finished but still not detected "
            f"(expected: {', '.join(p.requires) or '-'}). {msg2}"
        )
    return True, f"{p.name} installed from github.com/{slug}\n{msg}\n{msg2}"


def update_from_github(pid: str) -> tuple[bool, str]:
    """Pull latest from GitHub (existing clone preferred) and re-run install.sh."""
    p = get_project(pid)
    if not p:
        return False, f"unknown project: {pid}"
    slug = p.repo_slug()
    if not slug:
        return False, f"{p.name}: no GitHub repo configured (local-only)"

    repo = find_repo_dir(p)
    if repo:
        ok, dest, msg = clone_or_update(slug, dest=repo)
    else:
        ok, dest, msg = clone_or_update(slug)
    if not ok:
        return False, f"{p.name}: {msg}"

    ok2, msg2 = run_install_script(dest)
    invalidate_update_cache(slug)
    if not ok2:
        return False, f"{p.name}: pull ok ({msg}); install failed: {msg2}"

    # Refresh live state if currently wired (plugins/daemons)
    if is_enabled(p.id) and p.on_disk() and p.on_enable:
        try:
            p.on_enable()
        except Exception as e:
            return True, (
                f"{p.name} updated from github.com/{slug}\n{msg}\n{msg2}\n"
                f"(re-activate warn: {e})"
            )
    return True, f"{p.name} updated from github.com/{slug}\n{msg}\n{msg2}"


def update_all_available(*, only_outdated: bool = True) -> tuple[bool, str]:
    """Pull + reinstall every (outdated) GitHub project. De-dupes monorepos."""
    checks = check_all_updates(force=True) if only_outdated else {}
    lines: list[str] = []
    seen_slugs: set[str] = set()
    any_fail = False
    for p in PROJECTS:
        slug = p.repo_slug()
        if not slug:
            lines.append(f"· {p.id}: skip (no github / local-only)")
            continue
        if only_outdated:
            info = checks.get(p.id)
            if not info or not info.available:
                if info and info.status == "up_to_date":
                    lines.append(f"· {p.id}: already up to date")
                elif info and info.status == "no_local":
                    lines.append(f"· {p.id}: no local clone (install first)")
                elif info and info.status == "no_github":
                    lines.append(f"· {p.id}: skip (no github / local-only)")
                elif info:
                    label = info.short_label() or info.status
                    lines.append(f"· {p.id}: {label}")
                else:
                    lines.append(f"· {p.id}: skip")
                continue
        if slug in seen_slugs:
            # monorepo already pulled - reinstall this unit if install.sh is shared
            dest = find_repo_dir(p) or (SRC_ROOT / slug.split("/")[-1])
            if dest.is_dir() and (dest / "install.sh").is_file():
                ok, msg = run_install_script(dest)
                lines.append(f"· {p.id}: re-install after {slug} pull · {msg}")
                if not ok:
                    any_fail = True
            else:
                lines.append(f"· {p.id}: covered by {slug}")
            continue
        seen_slugs.add(slug)
        ok, msg = update_from_github(p.id)
        lines.append(f"· {p.id}: {msg}")
        if not ok:
            any_fail = True
    return (not any_fail), "\n".join(lines)


def install_all_missing() -> tuple[bool, str]:
    lines: list[str] = []
    # de-dupe by github repo so hypr-bits only clones once
    seen_slugs: set[str] = set()
    any_fail = False
    for p in PROJECTS:
        if p.on_disk():
            lines.append(f"· {p.id}: already on disk")
            continue
        slug = p.repo_slug()
        if not slug:
            lines.append(f"· {p.id}: skip (no github / local-only)")
            continue
        if slug in seen_slugs:
            # same monorepo - re-run install only if still missing
            if not p.on_disk():
                dest = SRC_ROOT / slug.split("/")[-1]
                if dest.is_dir():
                    ok, msg = run_install_script(dest)
                    lines.append(f"· {p.id}: re-install {msg}")
                    if not ok:
                        any_fail = True
            else:
                lines.append(f"· {p.id}: covered by {slug}")
            continue
        seen_slugs.add(slug)
        ok, msg = install_from_github(p.id)
        lines.append(f"· {p.id}: {msg}")
        if not ok:
            any_fail = True
    return (not any_fail), "\n".join(lines)


PROJECTS: list[Project] = build_projects()
PROJECT_BY_ID = {p.id: p for p in PROJECTS}


def get_project(key: str) -> Optional[Project]:
    k = key.strip().lower()
    if k in PROJECT_BY_ID:
        return PROJECT_BY_ID[k]
    # aliases
    aliases = {
        "self": "hyprmods",
        "manager": "hyprmods",
        "me": "hyprmods",
        "winmode": "winbar",
        "win": "winbar",
        "infini": "infiniscroll",
        "canvas": "infiniscroll",
        "themes": "theme",
        "theme-ui": "theme",
        "wallpaper": "wallpaper-boot",
        "wallpapers": "wallpaper-boot",
        "wp": "wallpaper-boot",
        "obs": "obs-replay",
        "replay": "obs-replay",
        "clicker": "autoclicker",
        "click": "autoclicker",
        "recency": "app-recency",
        "rofi-recency": "app-recency",
        "nominsize": "hypr-nominsize",
        "minimize": "hypr-minimize",
    }
    if k in aliases:
        return PROJECT_BY_ID[aliases[k]]
    hits = [p for p in PROJECTS if p.id.startswith(k) or p.name.lower().startswith(k)]
    return hits[0] if len(hits) == 1 else None


# ---------------------------------------------------------------------------
# generate hypr conf
# ---------------------------------------------------------------------------

def render_generated(state: dict[str, bool]) -> str:
    lines = [
        MARKER_BEGIN,
        "# Auto-generated by hyprmods. Edit via: hyprmods toggle <id>",
        f"# State: {ENABLED_FILE}",
        "",
    ]
    enabled = [p for p in PROJECTS if state.get(p.id, True) and p.on_disk()]
    if not enabled:
        lines.append("# (no projects enabled)")
    for p in enabled:
        if not p.conf_lines:
            continue
        lines.extend(p.conf_lines)
        lines.append("")
    # Super+Y lives on the hyprmods project. If that unit is missing/off,
    # still inject binds so the manager stays reachable.
    hm = next((p for p in PROJECTS if p.id == "hyprmods"), None)
    hm_wired = bool(
        hm and state.get("hyprmods", True) and hm.on_disk() and hm.conf_lines
    )
    if not hm_wired:
        lines.extend(
            [
                "# hyprmods manager (fallback - `hyprmods on hyprmods` to own these)",
                "bind = $mainMod, Y, exec, ~/.local/bin/hyprmods",
                "bind = $mainMod SHIFT, Y, exec, ~/.local/bin/hyprmods menu",
                "",
            ]
        )
    lines.extend([MARKER_END, ""])
    return "\n".join(lines)


def write_generated(state: dict[str, bool]) -> None:
    ensure_dirs()
    GENERATED.write_text(render_generated(state), encoding="utf-8")


def hypr_reload() -> None:
    run(["hyprctl", "reload"], timeout=15)


def ensure_hyprland_sources() -> tuple[bool, str]:
    """Ensure hyprland.conf sources hyprmods.conf; strip legacy project lines.

    Returns (changed, message).
    """
    if not HYPR_CONF.is_file():
        return False, "hyprland.conf missing"

    text = HYPR_CONF.read_text(encoding="utf-8")
    original = text

    # Patterns that used to live in the base conf - now owned by hyprmods.
    # Match full lines (optional whitespace).
    legacy = [
        r"^\s*exec-once\s*=\s*~/.local/bin/wallpaper-boot\b.*$",
        r"^\s*exec-once\s*=\s*~/.local/bin/winmode-boot\b.*$",
        r"^\s*exec-once\s*=\s*~/.local/bin/infiniscroll-boot\b.*$",
        r"^\s*exec-once\s*=\s*~/.local/bin/obs-boot\b.*$",
        r"^\s*exec-once\s*=\s*~/.local/bin/app-recency\b.*$",
        r"^\s*exec-once\s*=\s*hyprctl plugin load \$HOME/.local/lib/hypr-nominsize\.so\s*.*$",
        r"^\s*exec-once\s*=\s*hyprctl plugin load .*hypr-nominsize\.so\s*.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*W,\s*exec,\s*~/.local/bin/winmode\b.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*I,\s*exec,\s*~/.local/bin/infiniscroll\b.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*O,\s*exec,\s*~/.local/bin/toggle-opaque\b.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*B,\s*exec,\s*~/.local/bin/toggle-waybar\b.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*T,\s*exec,\s*~/.local/bin/theme-ui\b.*$",
        r"^\s*bind\s*=\s*\$mainMod,\s*Y,\s*exec,\s*~/.local/bin/hyprmods\b.*$",
        r"^\s*bind\s*=\s*\$mainMod\s*SHIFT,\s*Y,\s*exec,\s*~/.local/bin/hyprmods\b.*$",
        r"^\s*bind\s*=\s*SUPER,\s*F8,\s*exec,\s*~/.local/bin/obs-replay\b.*$",
        r"^\s*bind\s*=\s*SUPER,\s*F9,\s*exec,\s*~/.local/bin/obs-replay\b.*$",
        r"^\s*bind\s*=\s*SUPER\s*SHIFT,\s*F9,\s*exec,\s*~/.local/bin/obs-replay\b.*$",
        r"^\s*source\s*=\s*~/.config/hypr/mode\.conf\s*.*$",
        r"^\s*source\s*=\s*~/.config/hypr/infini\.conf\s*.*$",
    ]

    for pat in legacy:
        text = re.sub(pat, "", text, flags=re.MULTILINE)

    # Drop leftover section chrome after line removal
    text = re.sub(
        r"\n#{3,}\n### WINDOWS MODE\s*###\n#{3,}\n+(?:#.*\n)*",
        "\n",
        text,
    )
    text = re.sub(
        r"\n#{3,}\n### INFINITE SCROLL ###\n#{3,}\n+(?:#.*\n)*",
        "\n",
        text,
    )
    text = re.sub(
        r"\n### INFINITE SCROLL ###\n#{3,}\n+(?:#.*\n)*",
        "\n",
        text,
    )
    text = re.sub(
        r"\n# Overrides written/emptied by ~/.local/bin/(?:winmode|infiniscroll).*\n",
        "\n",
        text,
    )
    # collapse 3+ blank lines
    text = re.sub(r"\n{3,}", "\n\n", text)

    if SOURCE_LINE not in text and "hyprmods.conf" not in text:
        # append source at end so mode/infini overrides still win
        if not text.endswith("\n"):
            text += "\n"
        text += (
            "\n#################\n"
            "### HYPRMODS  ###\n"
            "#################\n"
            "# Project installs managed by ~/.local/bin/hyprmods\n"
            f"{SOURCE_LINE}\n"
        )
    elif SOURCE_LINE not in text:
        # weird partial - force correct line at end
        if not text.endswith("\n"):
            text += "\n"
        text += f"\n{SOURCE_LINE}\n"

    if text != original:
        # backup once
        bak = HYPR_CONF.with_suffix(".conf.pre-hyprmods")
        if not bak.exists():
            bak.write_text(original, encoding="utf-8")
        HYPR_CONF.write_text(text, encoding="utf-8")
        return True, f"migrated hyprland.conf (backup: {bak.name})"
    return False, "hyprland.conf already migrated"


# ---------------------------------------------------------------------------
# core enable/disable
# ---------------------------------------------------------------------------

def set_enabled(pid: str, want: bool, *, reload: bool = True) -> tuple[bool, str]:
    p = get_project(pid)
    if not p:
        return False, f"unknown project: {pid}"
    install_note = ""
    if want and not p.on_disk():
        if p.repo_slug():
            ok_i, msg_i = install_from_github(p.id)
            if not ok_i:
                return False, msg_i
            install_note = msg_i + "\n"
        else:
            return False, (
                f"{p.name}: not on disk and cannot auto-install "
                f"(need: {', '.join(p.requires) or '-'})"
            )

    state = load_enabled()
    was = bool(state.get(p.id, True))
    if was == want:
        # still re-apply conf so disk matches
        write_generated(state)
        ensure_hyprland_sources()
        if reload:
            hypr_reload()
        return True, install_note + f"{p.name} already {'enabled' if want else 'disabled'}"

    if want:
        state[p.id] = True
        save_enabled(state)
        write_generated(state)
        ensure_hyprland_sources()
        if reload:
            hypr_reload()
        if p.on_enable:
            try:
                p.on_enable()
            except Exception as e:
                return True, install_note + f"{p.name} enabled (activate warn: {e})"
        notify("hyprmods", f"{p.name} wired (enabled)")
        return True, install_note + f"{p.name} enabled - binds/boot active"
    else:
        # teardown first while hooks still exist
        if p.on_disable:
            try:
                p.on_disable()
            except Exception as e:
                notify("hyprmods", f"{p.name} disable warn: {e}")
        state[p.id] = False
        save_enabled(state)
        write_generated(state)
        ensure_hyprland_sources()
        if reload:
            hypr_reload()
        notify("hyprmods", f"{p.name} uninstalled (disabled)")
        return True, f"{p.name} disabled - hotkeys inert, boot removed"


def toggle_enabled(pid: str) -> tuple[bool, str]:
    p = get_project(pid)
    if not p:
        return False, f"unknown project: {pid}"
    return set_enabled(p.id, not is_enabled(p.id))


def apply_all() -> tuple[bool, str]:
    state = load_enabled()
    write_generated(state)
    changed, msg = ensure_hyprland_sources()
    hypr_reload()
    return True, f"applied · {msg}" if changed else "applied · conf rewritten + reload"


# ---------------------------------------------------------------------------
# CLI views
# ---------------------------------------------------------------------------

def format_binds_block(p: Project, *, indent: str = "         ") -> list[str]:
    """Pretty multi-line bind list for terminal."""
    if not p.binds:
        return [f"{indent}keys   (none - no keyboard binds)"]
    lines: list[str] = []
    # column widths within this project
    w_when = max(len(b.when) for b in p.binds)
    w_keys = max(len(b.keys) for b in p.binds)
    w_when = min(max(w_when, 8), 42)
    w_keys = min(max(w_keys, 8), 28)
    first = True
    for when, group in p.binds_by_when():
        for b in group:
            label = "keys  " if first else "      "
            first = False
            lines.append(
                f"{indent}{label}{b.when:<{w_when}}  {b.keys:<{w_keys}}  {b.action}"
            )
    return lines


def cmd_list(plain: bool = False, *, check_updates: bool = True) -> int:
    state = load_enabled()
    updates: dict[str, UpdateInfo] = {}
    if check_updates:
        try:
            updates = check_all_updates(force=False)
        except Exception:
            updates = {}

    if plain:
        for p in PROJECTS:
            en = "on" if state.get(p.id, True) and p.on_disk() else "off"
            if not p.on_disk():
                en = "missing"
            upd = updates.get(p.id)
            ver = ""
            if upd and upd.available:
                ver = "update"
            elif upd and upd.local_ver:
                ver = upd.local_ver
            print(f"{p.id}\t{en}\t{p.name}\t{ver}")
        return 0

    print(f"hyprmods · install manager · theme {current_theme()}")
    print(f"state  {ENABLED_FILE}")
    print(f"conf   {GENERATED}")
    print()
    n_upd = 0
    for p in PROJECTS:
        upd = updates.get(p.id)
        if not p.on_disk():
            mark = "✗ miss"
            gh = p.repo_slug()
            tag = f"not on disk · install: github.com/{gh}" if gh else "not on disk (local-only)"
        elif state.get(p.id, True):
            mark = "● ON "
            act = p.activity() if p.activity else ""
            tag = act or "wired"
        else:
            mark = "○ off"
            tag = "unwired"
        if upd and upd.available:
            n_upd += 1
            mark = "↑ UPD"
            extra = upd.short_label()
            tag = f"{extra} · {tag}" if tag else extra
        elif upd and upd.local_ver and p.on_disk():
            fv = _fmt_ver(upd.local_ver)
            # avoid "v0.1.1 · v0.1.1" when activity already shows the version
            if fv and fv not in (tag or ""):
                tag = f"{tag} · {fv}" if tag else fv
        print(f"  {mark}  {p.id:<16}  {p.name:<18}  {tag}")
        print(f"         {p.desc}")
        for line in format_binds_block(p):
            print(line)
        print()
    print("  toggle = wire/unwire Hyprland  ·  install = clone from GitHub if missing")
    if n_upd:
        print(f"  {n_upd} update(s) available · hyprmods update <id> · hyprmods update-all")
    else:
        print("  hyprmods install winbar · hyprmods update-all · hyprmods")
    return 0


def cmd_toggle(target: str, force: Optional[bool] = None) -> int:
    p = get_project(target)
    if not p:
        print(f"unknown: {target}", file=sys.stderr)
        print("ids:", ", ".join(x.id for x in PROJECTS), file=sys.stderr)
        return 1
    if force is None:
        ok, msg = toggle_enabled(p.id)
    else:
        ok, msg = set_enabled(p.id, force)
    print(msg)
    return 0 if ok else 1


def cmd_menu() -> int:
    state = load_enabled()
    try:
        updates = check_all_updates(force=False)
    except Exception:
        updates = {}
    lines = []
    for p in PROJECTS:
        upd = updates.get(p.id)
        if not p.on_disk():
            tag = "[miss]"
        elif upd and upd.available:
            tag = "[UPD]"
        elif state.get(p.id, True):
            tag = "[ON] "
        else:
            tag = "[off]"
        lines.append(f"{tag}  {p.name}\t{p.id}")
    payload = "\n".join(lines)

    choice = ""
    if which("rofi"):
        r = subprocess.run(
            [
                "rofi",
                "-dmenu",
                "-i",
                "-p",
                "hyprmods install",
                "-format",
                "s",
                "-theme-str",
                "window { width: 34em; } listview { lines: 12; }",
            ],
            input=payload,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if r.returncode != 0:
            return 0
        choice = (r.stdout or "").strip()
    elif which("wofi"):
        r = subprocess.run(
            ["wofi", "--dmenu", "-p", "hyprmods"],
            input=payload,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if r.returncode != 0:
            return 0
        choice = (r.stdout or "").strip()
    elif which("fzf"):
        r = subprocess.run(
            ["fzf", "--prompt=hyprmods> "],
            input=payload,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if r.returncode != 0:
            return 0
        choice = (r.stdout or "").strip()
    else:
        print("need rofi, wofi, or fzf", file=sys.stderr)
        return 1

    mid = choice.split("\t")[-1].strip() if "\t" in choice else ""
    if not mid:
        for p in PROJECTS:
            if p.name in choice:
                mid = p.id
                break
    if not mid:
        return 1
    return cmd_toggle(mid)


