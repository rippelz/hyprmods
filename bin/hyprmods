CAT_ORDER = ["project", "plugin", "utility"]
CAT_LABEL = {
    "project": "PROJECTS",
    "plugin": "PLUGINS",
    "utility": "UTILITIES",
}


def run_ui() -> int:
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Adw, Gdk, GLib, Gtk, Pango  # type: ignore

    class ProjectRow(Gtk.Box):
        def __init__(self, proj: Project, on_change: Callable[[], None]):
            super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            self.proj = proj
            self.on_change = on_change
            self._busy = False
            self.add_css_class("mod-row")
            self.set_hexpand(True)
            self.set_size_request(0, -1)

            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            left.set_hexpand(True)
            left.set_size_request(0, -1)
            self.name_lbl = Gtk.Label(label=proj.name, xalign=0)
            self.name_lbl.add_css_class("mod-name")
            self.name_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            self.name_lbl.set_hexpand(True)
            self.name_lbl.set_size_request(0, -1)
            left.append(self.name_lbl)
            self.desc_lbl = Gtk.Label(label=proj.desc, xalign=0, wrap=True)
            self.desc_lbl.add_css_class("mod-desc")
            self.desc_lbl.set_wrap(True)
            self.desc_lbl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            self.desc_lbl.set_hexpand(True)
            self.desc_lbl.set_size_request(0, -1)
            try:
                self.desc_lbl.set_natural_wrap_mode(Gtk.NaturalWrapMode.NONE)
            except Exception:
                pass
            left.append(self.desc_lbl)
            self.meta_lbl = Gtk.Label(label="", xalign=0)
            self.meta_lbl.add_css_class("mod-meta")
            self.meta_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            self.meta_lbl.set_hexpand(True)
            self.meta_lbl.set_size_request(0, -1)
            left.append(self.meta_lbl)

            # keybind cheat-sheet - stack key + action so narrow windows work
            self.bind_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            self.bind_box.add_css_class("bind-block")
            self.bind_box.set_hexpand(True)
            self.bind_box.set_size_request(0, -1)
            head = Gtk.Label(label="KEYBINDS", xalign=0)
            head.add_css_class("bind-head")
            head.set_size_request(0, -1)
            self.bind_box.append(head)
            if not proj.binds:
                none = Gtk.Label(label="none - no keyboard binds", xalign=0)
                none.add_css_class("bind-none")
                none.set_ellipsize(Pango.EllipsizeMode.END)
                none.set_size_request(0, -1)
                self.bind_box.append(none)
            else:
                for when, group in proj.binds_by_when():
                    wl = Gtk.Label(label=when, xalign=0, wrap=True)
                    wl.add_css_class("bind-when")
                    wl.set_wrap(True)
                    wl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                    wl.set_hexpand(True)
                    wl.set_size_request(0, -1)
                    try:
                        wl.set_natural_wrap_mode(Gtk.NaturalWrapMode.NONE)
                    except Exception:
                        pass
                    self.bind_box.append(wl)
                    for b in group:
                        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                        row.add_css_class("bind-row")
                        row.set_margin_bottom(4)
                        row.set_size_request(0, -1)
                        k = Gtk.Label(label=b.keys, xalign=0)
                        k.add_css_class("bind-keys")
                        k.set_ellipsize(Pango.EllipsizeMode.END)
                        k.set_hexpand(True)
                        k.set_size_request(0, -1)
                        a = Gtk.Label(label=b.action, xalign=0, wrap=True)
                        a.add_css_class("bind-action")
                        a.set_wrap(True)
                        a.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                        a.set_hexpand(True)
                        a.set_size_request(0, -1)
                        try:
                            a.set_natural_wrap_mode(Gtk.NaturalWrapMode.NONE)
                        except Exception:
                            pass
                        row.append(k)
                        row.append(a)
                        self.bind_box.append(row)
            left.append(self.bind_box)
            self.append(left)

            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            right.set_valign(Gtk.Align.START)
            self.status = Gtk.Label()
            self.status.add_css_class("status-dot")
            self.status.set_halign(Gtk.Align.END)
            right.append(self.status)

            self.switch = Gtk.Switch()
            self.switch.set_halign(Gtk.Align.END)
            self.switch.set_tooltip_text(
                "ON = wired into Hyprland\n"
                "OFF = binds/boot removed (practically uninstalled)\n"
                "If missing on disk, turning ON clones from GitHub first."
            )
            self.switch.connect("state-set", self._on_switch)
            right.append(self.switch)

            self.install_btn = Gtk.Button(label="Install from GitHub")
            self.install_btn.add_css_class("suggested-action")
            self.install_btn.set_halign(Gtk.Align.END)
            self.install_btn.set_visible(False)
            self.install_btn.connect("clicked", self._on_install)
            right.append(self.install_btn)

            self.update_btn = Gtk.Button(label="Update")
            self.update_btn.add_css_class("suggested-action")
            self.update_btn.set_halign(Gtk.Align.END)
            self.update_btn.set_visible(False)
            self.update_btn.set_tooltip_text(
                "Pull latest from GitHub and re-run install.sh"
            )
            self.update_btn.connect("clicked", self._on_update)
            right.append(self.update_btn)
            self.append(right)
            self.refresh()

        def refresh(self) -> None:
            self.remove_css_class("on")
            self.remove_css_class("missing")
            self.remove_css_class("update")
            for c in ("status-on", "status-off", "status-miss", "status-upd"):
                self.status.remove_css_class(c)

            upd = cached_update(self.proj)

            if not self.proj.on_disk():
                self.add_css_class("missing")
                self.status.set_label("missing")
                self.status.add_css_class("status-miss")
                self.switch.set_sensitive(False)
                self.switch.handler_block_by_func(self._on_switch)
                self.switch.set_state(False)
                self.switch.set_active(False)
                self.switch.handler_unblock_by_func(self._on_switch)
                gh = self.proj.repo_slug()
                if self.update_btn:
                    self.update_btn.set_visible(False)
                if gh:
                    self.meta_lbl.set_label(f"not on disk · github.com/{gh}")
                    if self.install_btn:
                        self.install_btn.set_visible(True)
                        self.install_btn.set_sensitive(not self._busy)
                else:
                    self.meta_lbl.set_label("not on disk · local-only (no GitHub)")
                    if self.install_btn:
                        self.install_btn.set_visible(False)
                return

            if self.install_btn:
                self.install_btn.set_visible(False)
            on = is_enabled(self.proj.id)
            has_upd = bool(upd and upd.available)
            if has_upd:
                self.add_css_class("update")
                self.status.set_label("UPDATE")
                self.status.add_css_class("status-upd")
            else:
                self.status.set_label("WIRED" if on else "off")
                self.status.add_css_class("status-on" if on else "status-off")
            if on and not has_upd:
                self.add_css_class("on")
            act = self.proj.activity() if self.proj.activity else ""
            n_keys = len(self.proj.binds)
            key_bit = f"{n_keys} key" + ("" if n_keys == 1 else "s")
            if n_keys == 0:
                key_bit = "no keys"
            bits = [f"id · {self.proj.id}", key_bit]
            if act:
                bits.append(act)
            if upd and upd.available:
                bits.append(upd.short_label())
            elif upd and upd.local_ver:
                bits.append(_fmt_ver(upd.local_ver))
            self.meta_lbl.set_label("  ·  ".join(bits))
            if self.update_btn:
                self.update_btn.set_visible(has_upd)
                self.update_btn.set_sensitive(not self._busy and has_upd)
                if not self._busy:
                    self.update_btn.set_label("Update")
            self.switch.set_sensitive(not self._busy)
            self.switch.handler_block_by_func(self._on_switch)
            self.switch.set_state(on)
            self.switch.set_active(on)
            self.switch.handler_unblock_by_func(self._on_switch)

        def _on_switch(self, switch: Gtk.Switch, state: bool) -> bool:
            if self._busy:
                return True
            self._busy = True
            switch.set_sensitive(False)
            want = state

            def work():
                ok, msg = set_enabled(self.proj.id, want)
                GLib.idle_add(self._done, ok, msg)

            threading.Thread(target=work, daemon=True).start()
            return True

        def _on_install(self, *_a) -> None:
            if self._busy:
                return
            self._busy = True
            if self.install_btn:
                self.install_btn.set_sensitive(False)
                self.install_btn.set_label("Installing…")

            def work():
                ok, msg = install_from_github(self.proj.id)
                if ok:
                    # also wire it on after a fresh install
                    ok2, msg2 = set_enabled(self.proj.id, True)
                    msg = msg + "\n" + msg2
                    ok = ok2
                GLib.idle_add(self._done, ok, msg)

            threading.Thread(target=work, daemon=True).start()

        def _on_update(self, *_a) -> None:
            if self._busy:
                return
            self._busy = True
            if self.update_btn:
                self.update_btn.set_sensitive(False)
                self.update_btn.set_label("Updating…")

            def work():
                ok, msg = update_from_github(self.proj.id)
                GLib.idle_add(self._done, ok, msg)

            threading.Thread(target=work, daemon=True).start()

        def _done(self, ok: bool, msg: str) -> bool:
            self._busy = False
            if self.install_btn:
                self.install_btn.set_label("Install from GitHub")
            if self.update_btn:
                self.update_btn.set_label("Update")
            time.sleep(0.05)
            self.refresh()
            self.on_change()
            notify(self.proj.name, (msg or "done")[:200])
            if not ok:
                pass
            return False

    def _soft_label(text: str = "", **kwargs) -> Gtk.Label:
        """Label that does not force a huge window min-width."""
        lab = Gtk.Label(label=text, xalign=0, **kwargs)
        lab.set_wrap(True)
        lab.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        try:
            lab.set_natural_wrap_mode(Gtk.NaturalWrapMode.NONE)
        except Exception:
            pass
        lab.set_hexpand(True)
        # Zero min width so parent can shrink; wrap/ellipsize handles overflow
        lab.set_size_request(0, -1)
        return lab

    class ManagerWindow(Adw.ApplicationWindow):
        def __init__(self, app: Adw.Application):
            super().__init__(application=app, title="hyprmods")
            self.rows: list[ProjectRow] = []
            self.set_default_size(520, 640)
            self.set_resizable(True)
            # Explicit tiny min - Hyprland otherwise clamps to GTK's content min
            self.set_size_request(200, 120)

            provider = Gtk.CssProvider()
            provider.load_from_data(APP_CSS.encode())
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(),
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

            # Entire UI inside one ScrolledWindow so the window min-size is
            # the scroll viewport, not the sum of every project card.
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            scroll.set_propagate_natural_width(False)
            scroll.set_propagate_natural_height(False)
            scroll.set_min_content_width(200)
            scroll.set_min_content_height(120)
            scroll.set_hexpand(True)
            scroll.set_vexpand(True)
            self.set_content(scroll)

            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.set_valign(Gtk.Align.START)
            root.set_halign(Gtk.Align.FILL)
            root.set_hexpand(True)
            root.set_size_request(0, -1)
            scroll.set_child(root)

            header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            header.add_css_class("header-bar")
            header.set_margin_top(16)
            header.set_margin_bottom(12)
            header.set_margin_start(18)
            header.set_margin_end(18)
            header.set_hexpand(True)
            header.set_size_request(0, -1)

            title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            title_row.set_hexpand(True)
            t = _soft_label("hyprmods")
            t.add_css_class("title-main")
            t.set_ellipsize(Pango.EllipsizeMode.END)
            t.set_wrap(False)
            title_row.append(t)
            header.append(title_row)
            root.append(header)

            list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            list_box.set_margin_start(14)
            list_box.set_margin_end(14)
            list_box.set_margin_bottom(8)
            list_box.set_hexpand(True)
            list_box.set_size_request(0, -1)
            root.append(list_box)

            by: dict[str, list[Project]] = {}
            for p in PROJECTS:
                by.setdefault(p.category, []).append(p)
            for cat in CAT_ORDER:
                if cat not in by:
                    continue
                sec = _soft_label(CAT_LABEL.get(cat, cat.upper()))
                sec.add_css_class("section-label")
                list_box.append(sec)
                for p in by[cat]:
                    row = ProjectRow(p, self._update_footer)
                    row.set_size_request(0, -1)
                    self.rows.append(row)
                    list_box.append(row)

            foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            foot.add_css_class("footer")
            foot.set_hexpand(True)
            foot.set_size_request(0, -1)
            self.status = _soft_label("")
            self.status.add_css_class("hint")
            self.status.set_ellipsize(Pango.EllipsizeMode.END)
            self.status.set_wrap(False)
            foot.append(self.status)
            install_all_btn = Gtk.Button(label="Install missing")
            install_all_btn.set_tooltip_text("Clone + install every missing GitHub project")
            install_all_btn.connect("clicked", self._install_all)
            foot.append(install_all_btn)
            self.update_all_btn = Gtk.Button(label="Update all")
            self.update_all_btn.set_tooltip_text(
                "Pull + reinstall every project with a newer GitHub version"
            )
            self.update_all_btn.connect("clicked", self._update_all)
            foot.append(self.update_all_btn)
            apply_btn = Gtk.Button(label="Re-apply")
            apply_btn.set_tooltip_text("Rewrite conf + hyprctl reload")
            apply_btn.connect("clicked", self._apply)
            foot.append(apply_btn)
            menu_btn = Gtk.Button(label="Rofi")
            menu_btn.connect(
                "clicked",
                lambda *_: threading.Thread(target=cmd_menu, daemon=True).start(),
            )
            foot.append(menu_btn)
            root.append(foot)

            key = Gtk.EventControllerKey()
            key.connect("key-pressed", self._on_key)
            self.add_controller(key)
            self._update_footer()
            self._check_updates_async(force=False)
            GLib.timeout_add_seconds(3, self._tick)

        def _tick(self) -> bool:
            if self.is_visible():
                for row in self.rows:
                    if not row._busy:
                        row.refresh()
                self._update_footer()
            return True

        def _check_updates_async(self, *, force: bool = False) -> None:
            """Background GitHub version check; refreshes rows when done."""

            def work():
                try:
                    check_all_updates(force=force)
                except Exception:
                    pass
                GLib.idle_add(self._after_update_check)

            threading.Thread(target=work, daemon=True).start()

        def _after_update_check(self) -> bool:
            for row in self.rows:
                if not row._busy:
                    row.refresh()
            self._update_footer()
            return False

        def refresh_all(self) -> None:
            for row in self.rows:
                row.refresh()
            self._update_footer()
            self._check_updates_async(force=True)

        def _update_footer(self) -> None:
            st = load_enabled()
            on = [p.name for p in PROJECTS if st.get(p.id, True) and p.on_disk()]
            off = [p.name for p in PROJECTS if not st.get(p.id, True) and p.on_disk()]
            n_upd = 0
            upd_names: list[str] = []
            seen_slugs: set[str] = set()
            for p in PROJECTS:
                info = cached_update(p)
                if info and info.available and info.slug not in seen_slugs:
                    seen_slugs.add(info.slug)
                    n_upd += 1
                    upd_names.append(p.name)
            bits = []
            if n_upd:
                bits.append(f"↑ {n_upd} update" + ("s" if n_upd != 1 else ""))
                if len(upd_names) <= 4:
                    bits[-1] += f" · {', '.join(upd_names)}"
            if on:
                bits.append(f"installed · {', '.join(on)}")
            if off:
                bits.append(f"off · {', '.join(off)}")
            self.status.set_label("  ·  ".join(bits) or "nothing on disk")
            if hasattr(self, "update_all_btn"):
                self.update_all_btn.set_sensitive(n_upd > 0)

        def _apply(self, *_a) -> None:
            def work():
                ok, msg = apply_all()
                GLib.idle_add(lambda: (self.refresh_all(), notify("hyprmods", msg), False)[-1])

            threading.Thread(target=work, daemon=True).start()

        def _install_all(self, *_a) -> None:
            def work():
                ok, msg = install_all_missing()
                GLib.idle_add(
                    lambda: (
                        self.refresh_all(),
                        notify("hyprmods", "install-all done" if ok else "install-all had errors"),
                        False,
                    )[-1]
                )

            threading.Thread(target=work, daemon=True).start()

        def _update_all(self, *_a) -> None:
            if hasattr(self, "update_all_btn"):
                self.update_all_btn.set_sensitive(False)
                self.update_all_btn.set_label("Updating…")

            def work():
                ok, msg = update_all_available(only_outdated=True)
                def done():
                    if hasattr(self, "update_all_btn"):
                        self.update_all_btn.set_label("Update all")
                    self.refresh_all()
                    notify(
                        "hyprmods",
                        "updates done" if ok else "update-all had errors",
                    )
                    return False
                GLib.idle_add(done)

            threading.Thread(target=work, daemon=True).start()

        def _on_key(self, _c, keyval, _code, state) -> bool:
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            if keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self.refresh_all()
                return True
            if Gdk.KEY_1 <= keyval <= Gdk.KEY_9:
                idx = keyval - Gdk.KEY_1
                usable = [r for r in self.rows if r.proj.on_disk()]
                if idx < len(usable):
                    row = usable[idx]
                    row.switch.set_active(not is_enabled(row.proj.id))
                    return True
            return False

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="dev.beebit.Hyprmods")
            self.window: Optional[ManagerWindow] = None

        def do_activate(self):
            # ensure wiring exists before UI
            state = load_enabled()
            write_generated(state)
            ensure_hyprland_sources()
            if not self.window:
                self.window = ManagerWindow(self)
            self.window.present()

    Adw.init()
    Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    return App().run(sys.argv[:1])


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main(argv: Optional[list[str]] = None) -> int:
    argv = list(argv if argv is not None else sys.argv[1:])

    # always keep conf generation possible
    ensure_dirs()

    parser = argparse.ArgumentParser(
        prog="hyprmods",
        description="Install/enable manager for Hyprland projects (not runtime modes).",
    )
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("ui", help="GTK manager (default)")
    p_list = sub.add_parser("list", aliases=["status"], help="show install state")
    p_list.add_argument("--plain", action="store_true")
    sub.add_parser("ids")
    p_tog = sub.add_parser("toggle", help="install ↔ uninstall a project")
    p_tog.add_argument("project")
    p_on = sub.add_parser("on", help="enable (install wiring)")
    p_on.add_argument("project")
    p_off = sub.add_parser("off", help="disable (uninstall wiring)")
    p_off.add_argument("project")
    sub.add_parser("menu", help="rofi/wofi picker")
    sub.add_parser("apply", help="rewrite generated conf + reload")
    sub.add_parser("migrate", help="strip legacy lines from hyprland.conf")
    p_chk = sub.add_parser(
        "check",
        help="exit 0 if project is enabled (for other scripts)",
    )
    p_chk.add_argument("project")
    p_ins = sub.add_parser(
        "install",
        help="clone from GitHub + install.sh if binaries missing",
    )
    p_ins.add_argument("project")
    sub.add_parser(
        "install-all",
        help="install every missing project that has a GitHub repo",
    )
    p_upd = sub.add_parser(
        "update",
        help="pull latest from GitHub + re-run install.sh",
    )
    p_upd.add_argument("project")
    sub.add_parser(
        "update-all",
        help="update every project that is behind its GitHub remote",
    )
    p_outdated = sub.add_parser(
        "outdated",
        help="list projects with a newer version on GitHub",
    )
    p_outdated.add_argument(
        "--plain", action="store_true", help="id\\tlocal\\tremote per line"
    )

    if not argv:
        return run_ui()

    # shortcut: hyprmods winbar → toggle
    if argv[0] not in {
        "ui",
        "list",
        "status",
        "ids",
        "toggle",
        "on",
        "off",
        "menu",
        "apply",
        "migrate",
        "check",
        "install",
        "install-all",
        "update",
        "update-all",
        "outdated",
        "-h",
        "--help",
    }:
        if get_project(argv[0]):
            return cmd_toggle(argv[0])

    args = parser.parse_args(argv)

    if args.cmd in (None, "ui"):
        return run_ui()
    if args.cmd in ("list", "status"):
        return cmd_list(plain=getattr(args, "plain", False))
    if args.cmd == "ids":
        for p in PROJECTS:
            print(p.id)
        return 0
    if args.cmd == "toggle":
        return cmd_toggle(args.project)
    if args.cmd == "on":
        return cmd_toggle(args.project, force=True)
    if args.cmd == "off":
        return cmd_toggle(args.project, force=False)
    if args.cmd == "menu":
        return cmd_menu()
    if args.cmd == "apply":
        ok, msg = apply_all()
        print(msg)
        return 0 if ok else 1
    if args.cmd == "migrate":
        state = load_enabled()
        write_generated(state)
        changed, msg = ensure_hyprland_sources()
        hypr_reload()
        print(msg)
        print(f"generated {GENERATED}")
        return 0
    if args.cmd == "check":
        p = get_project(args.project)
        if not p:
            return 2
        return 0 if is_enabled(p.id) and p.on_disk() else 1
    if args.cmd == "install":
        ok, msg = install_from_github(args.project)
        print(msg)
        return 0 if ok else 1
    if args.cmd == "install-all":
        ok, msg = install_all_missing()
        print(msg)
        return 0 if ok else 1
    if args.cmd == "update":
        ok, msg = update_from_github(args.project)
        print(msg)
        return 0 if ok else 1
    if args.cmd == "update-all":
        ok, msg = update_all_available(only_outdated=True)
        print(msg)
        return 0 if ok else 1
    if args.cmd == "outdated":
        updates = check_all_updates(force=True)
        plain = getattr(args, "plain", False)
        n = 0
        seen: set[str] = set()
        for p in PROJECTS:
            info = updates.get(p.id)
            if not info or not info.available:
                continue
            if info.slug in seen:
                continue
            seen.add(info.slug)
            n += 1
            if plain:
                print(
                    f"{p.id}\t{info.local_ver or info.local_sha[:7]}\t"
                    f"{info.remote_ver or info.remote_sha[:7]}\t{info.slug}"
                )
            else:
                print(f"  ↑  {p.id:<16}  {info.short_label()}  ({info.slug})")
        if not plain:
            if n == 0:
                print("all checked projects are up to date")
            else:
                print(f"\n{n} repo(s) behind GitHub · hyprmods update-all")
        return 0 if n == 0 else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
